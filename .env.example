# Metallian Photos — Environment Variables
#
# Copy to .env and fill in real values. In production (Fly.io), set via:
#   fly secrets set APP_ADMIN__USERNAME=...
#   fly secrets set APP_ADMIN__PASSWORD=...
#   fly secrets set APP_STORAGE__R2_ACCESS_KEY=...
#   fly secrets set APP_STORAGE__R2_SECRET_KEY=...

# Environment: "local" or "production"
APP_ENVIRONMENT=local

# Application
APP_APPLICATION__HOST=127.0.0.1
APP_APPLICATION__PORT=8000

# Database — SQLite path (use /data/metallian-photos.db on Fly.io)
APP_DATABASE__PATH=metallian-photos.db

# Admin credentials (session-based auth)
APP_ADMIN__USERNAME=
APP_ADMIN__PASSWORD=

# Storage backend: "memory" (local dev) or "r2" (production)
APP_STORAGE__BACKEND=memory

# Cloudflare R2 (only needed when backend = "r2")
APP_STORAGE__R2_BUCKET=
APP_STORAGE__R2_ENDPOINT=
APP_STORAGE__R2_ACCESS_KEY=
APP_STORAGE__R2_SECRET_KEY=

# Logging (tracing filter)
RUST_LOG=info
